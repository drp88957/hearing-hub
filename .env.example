# Copy this file to .env and fill in ONE of the keys.
# The app looks for .env in this folder first, then in the folder above it.

# Course key (uses model gpt-6-luna)
PORTKEY_API_KEY=

# OR your own OpenAI key (uses HUB_MODEL below, default gpt-4o-mini)
OPENAI_API_KEY=

# ---- Optional settings (safe to leave out) ----
# HUB_MODEL=gpt-6-luna
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_PROVIDER=          # only if your Portkey setup needs it
# PORTKEY_VIRTUAL_KEY=       # only if your Portkey setup needs it
# HUB_REASONING_EFFORT=none  # gpt-6-luna needs "none" to use tools on /chat/completions

# Safety limits
# HUB_TOKEN_BUDGET=400000    # total tokens the server will spend before refusing (web contact lookups ~15k each)
# HUB_REQ_PER_MIN=12         # AI requests per minute per visitor
# HUB_MAX_STEPS=4            # max tool-use steps per agent run

# Price per 1M tokens, to show dollar cost in the app (leave blank to hide)
# PRICE_IN_PER_M=
# PRICE_CACHED_PER_M=
# PRICE_OUT_PER_M=
